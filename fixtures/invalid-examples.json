        "challenge": {
          "value": "AAAAAAAAAAAAAAAAAAAAAA",
          "issuedAt": "2026-08-10T12:00:00Z"
        },
        "proof": {
          "type": "DataIntegrityProof",
          "cryptosuite": "eddsa-jcs-2022",
